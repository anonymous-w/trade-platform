# Copy to .env and replace both secrets with strong, unique values.
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME
DEMO_DATA_ENABLED=true
WEB_PORT=8088
# Set true only behind a correctly configured HTTPS ingress.
COOKIE_SECURE=false

# Keep the same project name so restarts reuse the existing volumes.
COMPOSE_PROJECT_NAME=trade-platform-v02
